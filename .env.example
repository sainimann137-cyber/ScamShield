# ==============================================================================
# ScamShield Server Configuration
# ==============================================================================
# Copy this file to '.env' and populate your secrets.
# NEVER commit your real '.env' file or secrets to version control.
# ==============================================================================

# Google Gemini API Key (Obtain free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Set to 1 to force deterministic offline mock mode for automated testing
SCAMSHIELD_MOCK_MODE=0
